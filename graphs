<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Schema Graph</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://unpkg.com/3d-force-graph"></script>
  <style>
    body { margin: 0; overflow: hidden; }
    #3d-graph { width: 100vw; height: 100vh; }

    .table-node {
      background: #fff;
      border: 1px solid #ccc;
      border-radius: 6px;
      padding: 6px 10px;
      font-family: monospace;
      font-size: 12px;
      color: #222;
      box-shadow: 2px 2px 4px rgba(0,0,0,0.2);
      max-width: 200px;
    }

    .table-title {
      font-weight: bold;
      margin-bottom: 4px;
      color: #005ea2;
    }

    .table-field {
      margin-left: 8px;
    }
  </style>
</head>
<body>
  <div id="3d-graph"></div>

  <script>
    const graphData = {
      nodes: [
        { id: 'users', name: 'Users', columns: ['id', 'name', 'email'] },
        { id: 'orders', name: 'Orders', columns: ['id', 'user_id', 'amount'] },
        { id: 'products', name: 'Products', columns: ['id', 'name', 'price'] },
        { id: 'order_items', name: 'OrderItems', columns: ['order_id', 'product_id', 'quantity'] }
      ],
      links: [
        { source: 'users', target: 'orders' },
        { source: 'orders', target: 'order_items' },
        { source: 'products', target: 'order_items' }
      ]
    };

    const Graph = ForceGraph3D()(document.getElementById('3d-graph'))
      .graphData(graphData)
      .nodeLabel(node => {
        const html = `
          <div class="table-node">
            <div class="table-title">${node.name}</div>
            ${node.columns.map(col => `<div class="table-field">• ${col}</div>`).join('')}
          </div>
        `;
        return html;
      })
      .nodeAutoColorBy('id')
      .linkColor(() => '#999')
      .linkDirectionalParticles(2)
      .linkDirectionalParticleWidth(1)
      .backgroundColor('#ffffff');
  </script>
</body>
</html>
