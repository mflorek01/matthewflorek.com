NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_redesign
AUTH_SESSION_SECRET=replace-with-a-long-random-secret-in-production

# Optional feature flags
ENABLE_CMS_SYNC=false
ENABLE_METAMORPHYSIS_SYNC=false
ENABLE_AI_FEATURES=false
ENABLE_UMAMI=false
# Public pages read the checked-in source by default. Set database only after
# the portfolio database has a reviewed migration baseline and published data.
PUBLIC_CONTENT_MODE=static

# Optional CMS service inputs
CMS_BASE_URL=
CMS_API_TOKEN=

# Optional Metamorphysis one-way import. These are server-only.
METAMORPHYSIS_SYNC_URL=
METAMORPHYSIS_SYNC_TOKEN=
METAMORPHYSIS_ADMIN_TOKEN=
METAMORPHYSIS_SYNC_ALLOWED_IPS=
METAMORPHYSIS_TRUSTED_PROXY=false
METAMORPHYSIS_ADMIN_RATE_LIMIT_REQUESTS=30
METAMORPHYSIS_ADMIN_RATE_LIMIT_WINDOW_SECONDS=60

# Optional public assistant. It is fail-closed unless the flag, key, and model
# are all present. Keep every value below server-only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional hosted retrieval. This must be one dedicated vector store whose
# contents are managed as public-only; document rows never authorize a store.
OPENAI_AI_PUBLIC_VECTOR_STORE_ID=
OPENAI_AI_PUBLIC_VECTOR_STORE_PUBLIC_ONLY=false
AI_RATE_LIMIT_SALT=
AI_TRUSTED_PROXY=false
AI_ADMIN_TOKEN=
AI_KNOWLEDGE_ROOT=./content/ai-knowledge
AI_MAX_BODY_BYTES=40000
AI_MAX_MESSAGES=8
AI_MAX_MESSAGE_CHARS=2000
AI_MAX_PROMPT_CHARS=10000
AI_MAX_OUTPUT_TOKENS=700
AI_MAX_CONCURRENT=2
AI_RATE_LIMIT_REQUESTS=8
AI_RATE_LIMIT_WINDOW_SECONDS=3600
AI_DAILY_CALL_LIMIT=30
AI_DAILY_DOLLAR_LIMIT=1.5
AI_INPUT_COST_PER_MILLION_USD=5
AI_OUTPUT_COST_PER_MILLION_USD=30

# Public browser configuration for the optional self-hosted Umami tracker.
# These values are intentionally non-secret and are safe to expose to browsers.
NEXT_PUBLIC_ANALYTICS_MODE=off
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_DOMAINS=matthewflorek.com

# Admin bootstrap is a one-time operator action; never commit real values.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
CONFIRM_BOOTSTRAP_ADMIN=

# Compose-only deployment inputs.
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=
PORTFOLIO_ENV_FILE=.env
PORTFOLIO_HOST_PORT=3101
VCS_REF=unknown
PORTFOLIO_MIGRATOR_IMAGE=portfolio-redesign-migrator:local

# Optional Umami Compose inputs; keep this database and credentials separate.
UMAMI_IMAGE=ghcr.io/umami-software/umami:postgresql-v2.19.0
UMAMI_POSTGRES_DB=umami
UMAMI_POSTGRES_USER=umami
UMAMI_POSTGRES_PASSWORD=
UMAMI_APP_SECRET=
UMAMI_HOST_PORT=3110
